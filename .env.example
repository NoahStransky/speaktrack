# =============================================================================
# SpeakTrack — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
#   Local:   postgresql://postgres:postgres@localhost:5432/speaktrack
#   Neon:    postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/speaktrack?sslmode=require
#   Vercel:  postgres://default:pass@ep-xxx-pooler.us-east-1.postgres.vercel-storage.com/speaktrack?pgbouncer=true&connection_limit=1
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/speaktrack"

# ── Authentication (NextAuth v5) ─────────────────────────────────────────────
# Secret used to sign/encrypt JWT tokens and session cookies (required).
# Generate: openssl rand -base64 32
# =============================================================================
AUTH_SECRET=""

# Public URL of your deployment (required in production for redirects & CSRF).
#   Local:   http://localhost:3000
#   Vercel:  https://speaktrack.vercel.app
# =============================================================================
NEXTAUTH_URL="http://localhost:3000"
